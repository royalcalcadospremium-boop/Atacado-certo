          <div class="pf-faq-a"><p>Nada de burocracia: aumente a quantidade aqui mesmo na página. A partir de 10 unidades o preço de atacado é aplicado, e quanto mais unidades, menor o preço por unidade. Para pedidos acima de 500 unidades, chame no WhatsApp que a gente monta uma condição especial.</p></div>
        </div>
        <div class="pf-faq-item">
          <button type="button" class="pf-faq-q">Emitem nota fiscal?<svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6"/></svg></button>
          <div class="pf-faq-a"><p>Sim, todo pedido sai com nota fiscal. Se você revende e precisa da nota no CNPJ da sua empresa, é só informar os dados no checkout ou avisar a equipe no WhatsApp.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  <section class="pf-sec pf-dark">
    <div class="pf-wrap pf-narrow pf-final pf-rev">
      <h2>Kit completo, duas baterias e maleta por <span style="color:var(--pf-yellow);">{{ unit | money }}</span></h2>
      <p>Ou {{ pix | money }} pagando no Pix. Despacho em até 48h com rastreio.</p>
      <button type="button" class="pf-buy" data-jump-buy>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
        QUERO O MEU AGORA
      </button>
      <p class="pf-final-note">Compra protegida · Troca garantida · Suporte no WhatsApp</p>
    </div>
  </section>

  <!-- ============ BARRA FIXA (mobile) ============ -->
  <div class="pf-sticky" id="pf-sticky">
    <div class="pf-sticky-info">
      <b id="pf-sticky-price">{{ unit | money }}</b>
      <span>ou 12x de {{ parcela | money }}</span>
    </div>
    <button type="button" class="pf-buy" data-jump-buy>COMPRAR</button>
  </div>

</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{% for media in product.media %}{{ media | img_url: '1200x' | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": "Parafusadeira e furadeira 48V com duas baterias de lítio, duas velocidades, 35 N·m de torque, luz LED e maleta com 28 acessórios.",
  "sku": {{ v.sku | default: product.id | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: product.url | json }},
    "priceCurrency": {{ shop.currency | json }},
    "price": "{{ unit | divided_by: 100.0 }}",
    "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>

<script>
(function(){
  var root = document.getElementById('pf-lp');
  if(!root) return;

  /* ---- galeria ---- */
  var hero = document.getElementById('pf-hero-img');
  root.querySelectorAll('.pf-thumbs button').forEach(function(b){
    b.addEventListener('click', function(){
      if(hero) hero.src = b.dataset.full;
      root.querySelectorAll('.pf-thumbs button').forEach(function(o){ o.classList.remove('is-on'); });
      b.classList.add('is-on');
    });
  });

  /* ---- variantes: troca preço e foto ---- */
  var priceNow = document.getElementById('pf-price-now');
  var stickyPrice = document.getElementById('pf-sticky-price');
  root.querySelectorAll('input[name="id"]').forEach(function(r){
    r.addEventListener('change', function(){
      if(r.dataset.price && priceNow) priceNow.textContent = r.dataset.price;
      if(r.dataset.price && stickyPrice) stickyPrice.textContent = r.dataset.price;
      if(r.dataset.img && hero){
        hero.src = r.dataset.img;
        root.querySelectorAll('.pf-thumbs button').forEach(function(o){ o.classList.remove('is-on'); });
      }
    });
  });

  /* ---- quantidade + aviso de atacado ---- */
  var qty = document.getElementById('pf-qty');
  var note = document.getElementById('pf-tier-note');
  var tiers = [
    { min: 200, txt: 'Faixa máxima de desconto liberada — melhor preço por unidade da tabela.' },
    { min: 100, txt: 'Preço de atacado 100+ aplicado. Suba para 200 unidades e o preço cai mais.' },
    { min: 50,  txt: 'Preço de atacado 50+ aplicado. Suba para 100 unidades e o preço cai mais.' },
    { min: 10,  txt: 'Preço de atacado liberado (15% off). Suba para 50 unidades e o preço cai mais.' },
    { min: 2,   txt: 'Faltam poucas unidades para os 10 do atacado e destravar 15% de desconto.' }
  ];
  function refreshNote(){
    if(!qty || !note) return;
    var n = parseInt(qty.value, 10) || 1;
    var hit = tiers.find(function(t){ return n >= t.min; });
    if(hit){ note.textContent = hit.txt; note.classList.add('is-on'); }
    else { note.classList.remove('is-on'); }
  }
  root.querySelectorAll('.pf-stepper button').forEach(function(b){
    b.addEventListener('click', function(){
      var n = (parseInt(qty.value, 10) || 1) + parseInt(b.dataset.step, 10);
      qty.value = n < 1 ? 1 : n;
      refreshNote();
    });
  });
  root.querySelectorAll('.pf-presets button').forEach(function(b){
    b.addEventListener('click', function(){ qty.value = b.dataset.set; refreshNote(); });
  });
  if(qty) qty.addEventListener('input', refreshNote);
  refreshNote();

  /* ---- botões que levam à compra ---- */
  var form = document.getElementById('pf-form');
  root.querySelectorAll('[data-jump-buy]').forEach(function(b){
    b.addEventListener('click', function(){
      if(!form) return;
      form.scrollIntoView({ behavior:'smooth', block:'center' });
    });
  });

  /* ---- FAQ ---- */
  root.querySelectorAll('.pf-faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.parentElement;
      var panel = item.querySelector('.pf-faq-a');
      var open = item.classList.contains('is-on');
      root.querySelectorAll('.pf-faq-item.is-on').forEach(function(o){
        o.classList.remove('is-on');
        o.querySelector('.pf-faq-a').style.maxHeight = '0px';
      });
      if(!open){
        item.classList.add('is-on');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });

  /* ---- barra fixa ---- */
  var sticky = document.getElementById('pf-sticky');
  if(sticky && form){
    var io2 = new IntersectionObserver(function(es){
      es.forEach(function(e){ sticky.classList.toggle('is-on', !e.isIntersecting); });
    }, { threshold: 0 });
    io2.observe(form);
  }

  /* ---- reveal ---- */
  var els = root.querySelectorAll('.pf-rev');
  if(!('IntersectionObserver' in window)){
    els.forEach(function(el){ el.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function(el){ io.observe(el); });
  }
})();
</script>

