{%- comment -%}
  ============================================================
  PARAFUSADEIRA 48V — Página de venda completa
  Uso: no admin, no produto, escolha o template "parafusadeira".
  Conteudo inline de proposito: o arquivo de secao nao sincroniza
  com o tema, entao a pagina nao pode depender dele.
  ============================================================
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign unit = v.price -%}
{%- assign p10 = unit | times: 0.85 | floor -%}
{%- assign p50 = p10 | minus: 100 -%}
{%- assign p100 = p10 | minus: 200 -%}
{%- assign p200 = p10 | minus: 300 -%}
{%- assign parcela = unit | divided_by: 12 -%}
{%- assign pix = unit | times: 0.95 | floor -%}
{%- assign wa = 'https://wa.me/5562991902661' -%}

<style>
  #pf-lp{
    --pf-ink:#111418;
    --pf-muted:#5B6470;
    --pf-line:#E4E7EC;
    --pf-soft:#F6F7F9;
    --pf-yellow:#FFC300;
    --pf-yellow-d:#E0A800;
    --pf-buy:#12A150;
    --pf-buy-d:#0E8543;
    --pf-red:#D92D20;

    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    color:var(--pf-ink);
    background:#fff;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
    width:100%;
    max-width:100vw;
  }
  #pf-lp *,#pf-lp *::before,#pf-lp *::after{box-sizing:border-box;}
  #pf-lp h1,#pf-lp h2,#pf-lp h3,#pf-lp h4,#pf-lp p,#pf-lp ul,#pf-lp ol,#pf-lp li,#pf-lp figure{margin:0;padding:0;}
  #pf-lp ul,#pf-lp ol{list-style:none;}
  #pf-lp img{display:block;max-width:100%;}
  #pf-lp button{font:inherit;border:0;cursor:pointer;background:none;color:inherit;}
  #pf-lp a{text-decoration:none;color:inherit;}
  #pf-lp table{border-collapse:collapse;width:100%;}

  #pf-lp .pf-wrap{width:100%;max-width:76rem;margin:0 auto;padding:0 1.15rem;}
  #pf-lp .pf-narrow{max-width:48rem;}
  #pf-lp .pf-sec{padding:3.25rem 0;}
  #pf-lp .pf-soft{background:var(--pf-soft);}
  #pf-lp .pf-dark{background:var(--pf-ink);color:#fff;}

  #pf-lp .pf-eyebrow{
    display:inline-block;font-size:.72rem;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--pf-muted);margin-bottom:.7rem;
  }
  #pf-lp .pf-h2{font-size:1.65rem;font-weight:800;line-height:1.2;letter-spacing:-.02em;}
  #pf-lp .pf-h2 em{font-style:normal;background:linear-gradient(transparent 62%,var(--pf-yellow) 62%);}
  #pf-lp .pf-sub{margin-top:.7rem;color:var(--pf-muted);font-size:1rem;}
  #pf-lp .pf-head{max-width:42rem;margin-bottom:2rem;}
  #pf-lp .pf-center{text-align:center;margin-left:auto;margin-right:auto;}

  /* ---------- barra topo ---------- */
  #pf-lp .pf-bar{background:var(--pf-ink);color:#fff;overflow:hidden;padding:.55rem 0;}
  #pf-lp .pf-bar-track{display:inline-block;white-space:nowrap;animation:pf-slide 38s linear infinite;}
  #pf-lp .pf-bar-track span{
    display:inline-block;padding-right:2.5rem;font-size:.74rem;font-weight:800;
    letter-spacing:.09em;text-transform:uppercase;
  }
  #pf-lp .pf-bar b{color:var(--pf-yellow);}
  @keyframes pf-slide{from{transform:translateX(0)}to{transform:translateX(-50%)} }

  /* ---------- hero ---------- */
  #pf-lp .pf-hero{padding:1.75rem 0 2.5rem;}
  #pf-lp .pf-hero-grid{display:grid;gap:1.75rem;}

  #pf-lp .pf-gal-main{
    position:relative;border:1px solid var(--pf-line);border-radius:1rem;overflow:hidden;
    background:#fff;aspect-ratio:1/1;
  }
  #pf-lp .pf-gal-main img{width:100%;height:100%;object-fit:cover;}
  #pf-lp .pf-flag{
    position:absolute;top:.8rem;left:.8rem;z-index:2;display:flex;flex-direction:column;gap:.4rem;align-items:flex-start;
  }
  #pf-lp .pf-flag span{
    background:var(--pf-red);color:#fff;font-size:.7rem;font-weight:800;letter-spacing:.06em;
    text-transform:uppercase;padding:.32rem .6rem;border-radius:.4rem;
  }
  #pf-lp .pf-flag span.pf-flag-y{background:var(--pf-yellow);color:var(--pf-ink);}
  #pf-lp .pf-thumbs{display:flex;gap:.5rem;margin-top:.6rem;overflow-x:auto;padding-bottom:.2rem;scrollbar-width:thin;}
  #pf-lp .pf-thumbs button{
    flex:0 0 4.25rem;height:4.25rem;border-radius:.6rem;overflow:hidden;
    border:2px solid var(--pf-line);background:#fff;transition:border-color .2s;
  }
  #pf-lp .pf-thumbs button.is-on{border-color:var(--pf-ink);}
  #pf-lp .pf-thumbs img{width:100%;height:100%;object-fit:cover;}

  #pf-lp .pf-buybox{display:flex;flex-direction:column;gap:1.1rem;}
  #pf-lp .pf-stars{display:flex;align-items:center;gap:.4rem;font-size:.85rem;color:var(--pf-muted);}
  #pf-lp .pf-stars svg{width:1rem;height:1rem;fill:var(--pf-yellow);}
  #pf-lp .pf-h1{font-size:1.6rem;font-weight:800;line-height:1.22;letter-spacing:-.025em;}
  #pf-lp .pf-kicker{font-size:.95rem;color:var(--pf-muted);}

  #pf-lp .pf-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:.55rem;}
  #pf-lp .pf-price-now{font-size:2.1rem;font-weight:800;letter-spacing:-.03em;line-height:1;}
  #pf-lp .pf-price-was{font-size:1rem;color:var(--pf-muted);text-decoration:line-through;}
  #pf-lp .pf-price-off{
    background:#FEF3F2;color:var(--pf-red);font-size:.78rem;font-weight:800;
    padding:.2rem .5rem;border-radius:.35rem;
  }
  #pf-lp .pf-pay{font-size:.9rem;color:var(--pf-muted);}
  #pf-lp .pf-pay b{color:var(--pf-ink);}

  #pf-lp .pf-opt-label{font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem;}
  #pf-lp .pf-opt-label i{font-style:normal;color:var(--pf-muted);font-weight:600;text-transform:none;letter-spacing:0;}
  #pf-lp .pf-variants{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;}
  #pf-lp .pf-variants input{position:absolute;opacity:0;pointer-events:none;}
  #pf-lp .pf-variants label{
    display:flex;align-items:center;gap:.6rem;padding:.6rem;border:2px solid var(--pf-line);
    border-radius:.7rem;cursor:pointer;transition:border-color .2s,background .2s;font-size:.86rem;font-weight:600;
  }
  #pf-lp .pf-variants input:checked + label{border-color:var(--pf-ink);background:#fff;}
  #pf-lp .pf-variants input:disabled + label{opacity:.4;cursor:not-allowed;text-decoration:line-through;}
  #pf-lp .pf-variants label img{width:2.4rem;height:2.4rem;border-radius:.45rem;object-fit:cover;flex-shrink:0;}

  #pf-lp .pf-qty-row{display:flex;gap:.55rem;align-items:stretch;}
  #pf-lp .pf-stepper{display:flex;align-items:center;border:2px solid var(--pf-line);border-radius:.7rem;overflow:hidden;}
  #pf-lp .pf-stepper button{width:2.6rem;font-size:1.15rem;font-weight:700;color:var(--pf-muted);}
  #pf-lp .pf-stepper input{
    width:3.2rem;text-align:center;border:0;font-size:1rem;font-weight:700;
    background:transparent;color:var(--pf-ink);-moz-appearance:textfield;padding:.6rem 0;
  }
  #pf-lp .pf-stepper input::-webkit-outer-spin-button,
  #pf-lp .pf-stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  #pf-lp .pf-presets{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;}
  #pf-lp .pf-presets button{
    border:1px solid var(--pf-line);border-radius:.5rem;padding:.4rem .6rem;
    font-size:.78rem;font-weight:700;color:var(--pf-muted);transition:all .2s;
  }
  #pf-lp .pf-presets button:hover{border-color:var(--pf-ink);color:var(--pf-ink);}

  #pf-lp .pf-tier-note{
    display:none;background:#F0FDF4;border:1px solid #BBF7D0;color:#166534;
    border-radius:.6rem;padding:.6rem .75rem;font-size:.85rem;font-weight:600;
  }
  #pf-lp .pf-tier-note.is-on{display:block;}

  #pf-lp .pf-buy{
    display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;
    background:var(--pf-buy);color:#fff;font-size:1.05rem;font-weight:800;letter-spacing:.01em;
    padding:1.05rem 1.25rem;border-radius:.8rem;box-shadow:0 8px 22px rgba(18,161,80,.28);
    transition:background .2s,transform .15s,box-shadow .2s;
  }
  #pf-lp .pf-buy:hover{background:var(--pf-buy-d);transform:translateY(-2px);box-shadow:0 12px 28px rgba(18,161,80,.34);}
  #pf-lp .pf-buy:active{transform:translateY(0);}
  #pf-lp .pf-buy[disabled]{background:#98A2B3;box-shadow:none;cursor:not-allowed;transform:none;}
  #pf-lp .pf-buy svg{width:1.25rem;height:1.25rem;}
  #pf-lp .pf-buy-alt{
    display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;
    border:2px solid var(--pf-line);border-radius:.8rem;padding:.8rem;font-weight:700;font-size:.92rem;
    transition:border-color .2s;
  }
  #pf-lp .pf-buy-alt:hover{border-color:#25D366;}
  #pf-lp .pf-buy-alt svg{width:1.15rem;height:1.15rem;fill:#25D366;}

  #pf-lp .pf-assur{display:grid;gap:.5rem;padding-top:.35rem;}
  #pf-lp .pf-assur li{display:flex;gap:.55rem;align-items:flex-start;font-size:.86rem;color:var(--pf-muted);}
  #pf-lp .pf-assur svg{width:1.05rem;height:1.05rem;flex-shrink:0;margin-top:.15rem;stroke:var(--pf-buy);fill:none;stroke-width:2.4;}
  #pf-lp .pf-assur b{color:var(--pf-ink);font-weight:700;}

  /* ---------- selos ---------- */
  #pf-lp .pf-trust{border-top:1px solid var(--pf-line);border-bottom:1px solid var(--pf-line);padding:1.4rem 0;}
  #pf-lp .pf-trust-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;}
  #pf-lp .pf-trust-item{display:flex;gap:.65rem;align-items:flex-start;}
  #pf-lp .pf-trust-item svg{width:1.4rem;height:1.4rem;flex-shrink:0;stroke:var(--pf-ink);fill:none;stroke-width:1.8;}
  #pf-lp .pf-trust-item b{display:block;font-size:.86rem;font-weight:800;}
  #pf-lp .pf-trust-item span{font-size:.78rem;color:var(--pf-muted);}

  /* ---------- dor / solução ---------- */
  #pf-lp .pf-pain{display:grid;gap:1rem;}
  #pf-lp .pf-pain-card{
    border:1px solid var(--pf-line);border-radius:1rem;padding:1.35rem;background:#fff;
  }
  #pf-lp .pf-pain-card .pf-ico{
    width:2.6rem;height:2.6rem;border-radius:.7rem;background:var(--pf-yellow);
    display:flex;align-items:center;justify-content:center;margin-bottom:.9rem;
  }
  #pf-lp .pf-pain-card .pf-ico svg{width:1.35rem;height:1.35rem;stroke:var(--pf-ink);fill:none;stroke-width:2;}
  #pf-lp .pf-pain-card h3{font-size:1.02rem;font-weight:800;margin-bottom:.45rem;}
  #pf-lp .pf-pain-card p{font-size:.92rem;color:var(--pf-muted);}

  /* ---------- kit ---------- */
  #pf-lp .pf-kit-grid{display:grid;gap:1.6rem;align-items:start;}
  #pf-lp .pf-kit-list{display:grid;gap:.55rem;}
  #pf-lp .pf-kit-list li{
    display:flex;gap:.7rem;align-items:flex-start;background:#fff;border:1px solid var(--pf-line);
    border-radius:.65rem;padding:.7rem .85rem;font-size:.9rem;
  }
  #pf-lp .pf-kit-list svg{width:1.05rem;height:1.05rem;flex-shrink:0;margin-top:.2rem;stroke:var(--pf-buy);fill:none;stroke-width:3;}
  #pf-lp .pf-kit-list b{font-weight:700;}
  #pf-lp .pf-kit-img{border-radius:1rem;overflow:hidden;border:1px solid var(--pf-line);}
  #pf-lp .pf-kit-total{
    margin-top:1rem;background:var(--pf-ink);color:#fff;border-radius:.8rem;padding:1rem 1.15rem;
    display:flex;align-items:center;gap:.8rem;
  }
  #pf-lp .pf-kit-total strong{font-size:1.5rem;font-weight:800;color:var(--pf-yellow);line-height:1;}
  #pf-lp .pf-kit-total span{font-size:.85rem;color:rgba(255,255,255,.75);}

  /* ---------- specs ---------- */
  #pf-lp .pf-specs{border:1px solid var(--pf-line);border-radius:1rem;overflow:hidden;background:#fff;}
  #pf-lp .pf-specs tr{border-bottom:1px solid var(--pf-line);}
  #pf-lp .pf-specs tr:last-child{border-bottom:0;}
  #pf-lp .pf-specs th{
    text-align:left;padding:.85rem 1rem;font-size:.8rem;font-weight:800;text-transform:uppercase;
    letter-spacing:.06em;color:var(--pf-muted);width:48%;vertical-align:top;
  }
  #pf-lp .pf-specs td{padding:.85rem 1rem;font-size:.92rem;font-weight:600;}

  /* ---------- comparativo ---------- */
  #pf-lp .pf-vs{border:1px solid var(--pf-line);border-radius:1rem;overflow:hidden;background:#fff;}
  #pf-lp .pf-vs thead th{
    background:var(--pf-soft);padding:.85rem .7rem;font-size:.76rem;font-weight:800;
    text-transform:uppercase;letter-spacing:.05em;text-align:center;
  }
  #pf-lp .pf-vs thead th:first-child{text-align:left;}
  #pf-lp .pf-vs thead th.pf-vs-me{background:var(--pf-yellow);color:var(--pf-ink);}
  #pf-lp .pf-vs td{padding:.8rem .7rem;font-size:.86rem;border-top:1px solid var(--pf-line);text-align:center;}
  #pf-lp .pf-vs td:first-child{text-align:left;font-weight:600;}
  #pf-lp .pf-vs .pf-yes{color:var(--pf-buy);font-weight:800;}
  #pf-lp .pf-vs .pf-no{color:#98A2B3;font-weight:800;}

  /* ---------- atacado ---------- */
  #pf-lp .pf-tiers{display:grid;gap:.7rem;}
  #pf-lp .pf-tier{
    display:flex;align-items:center;justify-content:space-between;gap:1rem;
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
    border-radius:.8rem;padding:.95rem 1.1rem;
  }
  #pf-lp .pf-tier.pf-tier-best{border-color:var(--pf-yellow);background:rgba(255,195,0,.1);}
  #pf-lp .pf-tier-q{font-size:.92rem;font-weight:700;}
  #pf-lp .pf-tier-q small{display:block;font-size:.74rem;font-weight:500;color:rgba(255,255,255,.6);}
  #pf-lp .pf-tier-p{font-size:1.25rem;font-weight:800;color:var(--pf-yellow);white-space:nowrap;}
  #pf-lp .pf-tier-p small{display:block;font-size:.7rem;font-weight:600;color:rgba(255,255,255,.6);text-align:right;}
  #pf-lp .pf-tier-cta{margin-top:1.4rem;display:grid;gap:.6rem;}

  /* ---------- garantia ---------- */
  #pf-lp .pf-guard{
    border:2px dashed var(--pf-line);border-radius:1.1rem;padding:1.75rem;text-align:center;background:#fff;
  }
  #pf-lp .pf-guard .pf-seal{
    width:3.4rem;height:3.4rem;margin:0 auto .9rem;border-radius:50%;background:var(--pf-buy);
    display:flex;align-items:center;justify-content:center;
  }
  #pf-lp .pf-guard .pf-seal svg{width:1.7rem;height:1.7rem;stroke:#fff;fill:none;stroke-width:2.4;}
  #pf-lp .pf-guard h2{font-size:1.3rem;font-weight:800;margin-bottom:.6rem;}
  #pf-lp .pf-guard p{color:var(--pf-muted);font-size:.95rem;max-width:34rem;margin:0 auto;}

  /* ---------- faq ---------- */
  #pf-lp .pf-faq{display:grid;gap:.6rem;}
  #pf-lp .pf-faq-item{border:1px solid var(--pf-line);border-radius:.8rem;background:#fff;overflow:hidden;}
  #pf-lp .pf-faq-q{
    display:flex;width:100%;align-items:center;justify-content:space-between;gap:1rem;
    padding:1rem 1.1rem;text-align:left;font-weight:700;font-size:.95rem;
  }
  #pf-lp .pf-faq-q svg{width:1.1rem;height:1.1rem;flex-shrink:0;stroke:var(--pf-muted);fill:none;stroke-width:2.4;transition:transform .25s;}
  #pf-lp .pf-faq-item.is-on .pf-faq-q svg{transform:rotate(180deg);}
  #pf-lp .pf-faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  #pf-lp .pf-faq-a p{padding:0 1.1rem 1.1rem;color:var(--pf-muted);font-size:.92rem;}

  /* ---------- cta final ---------- */
  #pf-lp .pf-final{text-align:center;}
  #pf-lp .pf-final h2{font-size:1.6rem;font-weight:800;line-height:1.2;margin-bottom:.6rem;}
  #pf-lp .pf-final p{color:rgba(255,255,255,.7);margin-bottom:1.5rem;}
  #pf-lp .pf-final .pf-buy{max-width:26rem;margin:0 auto;}
  #pf-lp .pf-final-note{margin-top:.9rem;font-size:.8rem;color:rgba(255,255,255,.55);}

  /* ---------- sticky ---------- */
  #pf-lp .pf-sticky{
    position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(255,255,255,.97);
    backdrop-filter:blur(10px);border-top:1px solid var(--pf-line);padding:.6rem .9rem;
    display:flex;align-items:center;gap:.8rem;transform:translateY(110%);transition:transform .3s ease;
    box-shadow:0 -4px 20px rgba(0,0,0,.08);
  }
  #pf-lp .pf-sticky.is-on{transform:translateY(0);}
  #pf-lp .pf-sticky-info{flex:1;min-width:0;}
  #pf-lp .pf-sticky-info b{display:block;font-size:1.05rem;font-weight:800;line-height:1.1;}
  #pf-lp .pf-sticky-info span{font-size:.72rem;color:var(--pf-muted);}
  #pf-lp .pf-sticky .pf-buy{width:auto;padding:.85rem 1.4rem;font-size:.95rem;}

  /* ---------- reveal ---------- */
  #pf-lp .pf-rev{opacity:0;transform:translateY(1.4rem);transition:opacity .55s ease,transform .55s ease;}
  #pf-lp .pf-rev.is-in{opacity:1;transform:none;}

  /* ================= 640px ================= */
  @media (min-width:640px){
    #pf-lp .pf-h1{font-size:1.9rem;}
    #pf-lp .pf-h2{font-size:2rem;}
    #pf-lp .pf-trust-grid{grid-template-columns:repeat(4,1fr);}
    #pf-lp .pf-pain{grid-template-columns:repeat(3,1fr);}
    #pf-lp .pf-final h2{font-size:2.1rem;}
  }

  /* ================= 900px ================= */
  @media (min-width:900px){
    #pf-lp .pf-sec{padding:4.5rem 0;}
    #pf-lp .pf-hero{padding:2.25rem 0 3.25rem;}
    #pf-lp .pf-hero-grid{grid-template-columns:1.05fr .95fr;gap:3rem;align-items:start;}
    #pf-lp .pf-buybox{position:sticky;top:1.5rem;}
    #pf-lp .pf-h1{font-size:2.15rem;}
    #pf-lp .pf-h2{font-size:2.3rem;}
    #pf-lp .pf-kit-grid{grid-template-columns:1fr 1fr;gap:3rem;}
    #pf-lp .pf-kit-list{grid-template-columns:1fr;}
    #pf-lp .pf-tiers{grid-template-columns:repeat(2,1fr);}
    #pf-lp .pf-sticky{display:none;}
  }
</style>

<div id="pf-lp">

  <!-- ============ BARRA TOPO ============ -->
  <div class="pf-bar">
    <div class="pf-bar-track">
      {%- for pass in (1..2) -%}
      <span>⚡ KIT COMPLETO COM <b>2 BATERIAS + MALETA</b></span><span>🚚 DESPACHO EM ATÉ <b>48H</b> COM RASTREIO</span><span>💳 <b>12X NO CARTÃO</b> OU PIX COM DESCONTO</span><span>🏷️ <b>ATACADO A PARTIR DE 10 UNIDADES</b></span><span>🛡️ <b>TROCA GARANTIDA</b> SEM BUROCRACIA</span>
      {%- endfor -%}
    </div>
  </div>

  <!-- ============ HERO + COMPRA ============ -->
  <section class="pf-hero">
    <div class="pf-wrap">
      <div class="pf-hero-grid">

        <!-- galeria -->
        <div>
          <div class="pf-gal-main">
            <div class="pf-flag">
              <span class="pf-flag-y">Kit 28 peças</span>
              {%- if v.compare_at_price > v.price -%}
                {%- assign off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
                <span>-{{ off }}% OFF</span>
              {%- endif -%}
            </div>
            {%- if product.media.size > 0 -%}
              <img id="pf-hero-img" src="{{ product.featured_media | img_url: '1200x' }}" alt="{{ product.title | escape }}" width="1200" height="1200" loading="eager">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
          <div class="pf-thumbs">
            {%- for media in product.media -%}
              <button type="button" class="{% if forloop.first %}is-on{% endif %}" data-full="{{ media | img_url: '1200x' }}" aria-label="Foto {{ forloop.index }}">
                <img src="{{ media | img_url: '160x' }}" alt="" loading="lazy" width="80" height="80">
              </button>
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>

        <!-- caixa de compra -->
        <div class="pf-buybox">

          <div class="pf-stars">
            {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>{%- endfor -%}
            <span>Vendido e enviado por <b>{{ shop.name }}</b></span>
          </div>

          <h1 class="pf-h1">Parafusadeira e Furadeira 48V com 2 Baterias de Lítio, Maleta e 28 Acessórios</h1>

