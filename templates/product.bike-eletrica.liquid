<script>
(function(){
  var root = document.getElementById('bk-lp');
  if(!root) return;

  /* ---- galeria ---- */
  var hero = document.getElementById('bk-hero-img');
  root.querySelectorAll('.bk-thumbs button').forEach(function(b){
    b.addEventListener('click', function(){
      if(hero) hero.src = b.dataset.full;
      root.querySelectorAll('.bk-thumbs button').forEach(function(o){ o.classList.remove('is-on'); });
      b.classList.add('is-on');
    });
  });

  /* ---- variantes: troca preco e foto ---- */
  var priceNow = document.getElementById('bk-price-now');
  var stickyPrice = document.getElementById('bk-sticky-price');
  root.querySelectorAll('input[name="id"]').forEach(function(r){
    r.addEventListener('change', function(){
      if(r.dataset.price && priceNow) priceNow.textContent = r.dataset.price;
      if(r.dataset.price && stickyPrice) stickyPrice.textContent = r.dataset.price;
      if(r.dataset.img && hero){
        hero.src = r.dataset.img;
        root.querySelectorAll('.bk-thumbs button').forEach(function(o){ o.classList.remove('is-on'); });
      }
    });
  });

  /* ---- quantidade + aviso de atacado ---- */
  var qty = document.getElementById('bk-qty');
  var note = document.getElementById('bk-tier-note');
  var tiers = [
    { min: 30, txt: 'Faixa maxima da tabela liberada — melhor preco por unidade. Acima de 50, fale com a equipe no WhatsApp.' },
    { min: 10, txt: 'Preco de atacado 10+ aplicado. Suba para 30 unidades e o preco por peca cai mais.' },
    { min: 3,  txt: 'Preco de atacado liberado! Suba para 10 unidades e o preco por peca cai mais.' },
    { min: 2,  txt: 'Falta 1 unidade para liberar o preco de atacado.' }
  ];
  function refreshNote(){
    if(!qty || !note) return;
    var n = parseInt(qty.value, 10) || 1;
    var hit = tiers.find(function(t){ return n >= t.min; });
    if(hit){ note.textContent = hit.txt; note.classList.add('is-on'); }
    else { note.classList.remove('is-on'); }
  }
  root.querySelectorAll('.bk-stepper button').forEach(function(b){
    b.addEventListener('click', function(){
      var n = (parseInt(qty.value, 10) || 1) + parseInt(b.dataset.step, 10);
      qty.value = n < 1 ? 1 : n;
      refreshNote();
    });
  });
  root.querySelectorAll('.bk-presets button').forEach(function(b){
    b.addEventListener('click', function(){ qty.value = b.dataset.set; refreshNote(); });
  });
  if(qty) qty.addEventListener('input', refreshNote);
  refreshNote();

  /* ---- botoes que levam a compra ---- */
  var form = document.getElementById('bk-form');
  root.querySelectorAll('[data-jump-buy]').forEach(function(b){
    b.addEventListener('click', function(){
      if(!form) return;
      form.scrollIntoView({ behavior:'smooth', block:'center' });
    });
  });

  /* ---- FAQ ---- */
  root.querySelectorAll('.bk-faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.parentElement;
      var panel = item.querySelector('.bk-faq-a');
      var open = item.classList.contains('is-on');
      root.querySelectorAll('.bk-faq-item.is-on').forEach(function(o){
        o.classList.remove('is-on');
        o.querySelector('.bk-faq-a').style.maxHeight = '0px';
      });
      if(!open){
        item.classList.add('is-on');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });

  /* ---- barra fixa ---- */
  var sticky = document.getElementById('bk-sticky');
  if(sticky && form){
    var io2 = new IntersectionObserver(function(es){
      es.forEach(function(e){ sticky.classList.toggle('is-on', !e.isIntersecting); });
    }, { threshold: 0 });
    io2.observe(form);
  }

  /* ---- reveal ---- */
  var els = root.querySelectorAll('.bk-rev');
  if(!('IntersectionObserver' in window)){
    els.forEach(function(el){ el.classList.add('is-in'); });
  } else {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { threshold: .12, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function(el){ io.observe(el); });
  }
})();
</script>

