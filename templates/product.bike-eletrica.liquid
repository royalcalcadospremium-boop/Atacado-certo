{%- comment -%}
  ============================================================
  BICICLETA ELETRICA 750W — Pagina de venda completa
  Serve para os 3 modelos Konnan (mesma ficha tecnica):
    - FAST TRAIL (PX-FT04)
    - WINNER     (LE-128)
    - VOYAGER    (LE-151)
  Uso: no admin, no produto, escolha o template "bike-eletrica".
  Conteudo inline de proposito: arquivo de secao nao sincroniza
  com o tema, entao a pagina nao pode depender dele.

  >>> PRECO DE ATACADO: veja o bloco "TABELA DE ATACADO" abaixo.
      Valores em CENTAVOS (399700 = R$ 3.997,00).
  ============================================================
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign unit = v.price -%}
{%- assign t = product.title | upcase -%}

{%- comment -%} --- detecta o modelo pelo titulo do produto --- {%- endcomment -%}
{%- assign modelo = 'Fat Bike 750W' -%}
{%- if t contains 'FAST TRAIL' -%}{%- assign modelo = 'Fast Trail 750W' -%}{%- endif -%}
{%- if t contains 'WINNER' -%}{%- assign modelo = 'Winner 750W' -%}{%- endif -%}
{%- if t contains 'VOYAGER' -%}{%- assign modelo = 'Voyager 750W' -%}{%- endif -%}

{%- comment -%}
  --- TABELA DE ATACADO ---
  Fast Trail tem preco de fornecedor confirmado para 3+ pecas (R$ 3.997,00).
  Nos demais modelos o padrao e 15% off, arredondado para real cheio.
  Para travar um valor especifico, troque o numero dentro do IF do modelo.
{%- endcomment -%}
{%- assign p3 = 0 -%}
{%- if modelo == 'Fast Trail 750W' -%}{%- assign p3 = 399700 -%}{%- endif -%}
{%- if p3 == 0 -%}
  {%- assign p3 = unit | times: 0.85 | floor | divided_by: 100 | times: 100 -%}
{%- endif -%}
{%- assign p10 = p3 | minus: 10000 -%}
{%- assign p30 = p3 | minus: 20000 -%}

{%- assign parcela = unit | divided_by: 12 -%}
{%- assign pix = unit | times: 0.95 | floor -%}
{%- assign economia3 = unit | minus: p3 -%}
{%- assign wa = 'https://wa.me/5562991902661' -%}

<style>
  #bk-lp{
    --bk-ink:#0F1418;
    --bk-muted:#5B6470;
    --bk-line:#E4E7EC;
    --bk-soft:#F6F7F9;
    --bk-accent:#FF7200;
    --bk-accent-d:#E05F00;
    --bk-buy:#12A150;
    --bk-buy-d:#0E8543;
    --bk-red:#D92D20;

    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    color:var(--bk-ink);
    background:#fff;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
    width:100%;
    max-width:100vw;
  }
  #bk-lp *,#bk-lp *::before,#bk-lp *::after{box-sizing:border-box;}
  #bk-lp h1,#bk-lp h2,#bk-lp h3,#bk-lp h4,#bk-lp p,#bk-lp ul,#bk-lp ol,#bk-lp li,#bk-lp figure{margin:0;padding:0;}
  #bk-lp ul,#bk-lp ol{list-style:none;}
  #bk-lp img{display:block;max-width:100%;}
  #bk-lp button{font:inherit;border:0;cursor:pointer;background:none;color:inherit;}
  #bk-lp a{text-decoration:none;color:inherit;}
  #bk-lp table{border-collapse:collapse;width:100%;}

  #bk-lp .bk-wrap{width:100%;max-width:76rem;margin:0 auto;padding:0 1.15rem;}
  #bk-lp .bk-narrow{max-width:48rem;}
  #bk-lp .bk-sec{padding:3.25rem 0;}
  #bk-lp .bk-soft{background:var(--bk-soft);}
  #bk-lp .bk-dark{background:var(--bk-ink);color:#fff;}

  #bk-lp .bk-eyebrow{
    display:inline-block;font-size:.72rem;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--bk-accent);margin-bottom:.7rem;
  }
  #bk-lp .bk-h2{font-size:1.65rem;font-weight:800;line-height:1.2;letter-spacing:-.02em;}
  #bk-lp .bk-h2 em{font-style:normal;background:linear-gradient(transparent 62%,rgba(255,114,0,.32) 62%);}
  #bk-lp .bk-sub{margin-top:.7rem;color:var(--bk-muted);font-size:1rem;}
  #bk-lp .bk-head{max-width:42rem;margin-bottom:2rem;}
  #bk-lp .bk-center{text-align:center;margin-left:auto;margin-right:auto;}

  /* ---------- barra topo ---------- */
  #bk-lp .bk-bar{background:var(--bk-ink);color:#fff;overflow:hidden;padding:.55rem 0;}
  #bk-lp .bk-bar-track{display:inline-block;white-space:nowrap;animation:bk-slide 40s linear infinite;}
  #bk-lp .bk-bar-track span{
    display:inline-block;padding-right:2.5rem;font-size:.74rem;font-weight:800;
    letter-spacing:.09em;text-transform:uppercase;
  }
  #bk-lp .bk-bar b{color:var(--bk-accent);}
  @keyframes bk-slide{from{transform:translateX(0)}to{transform:translateX(-50%)} }

  /* ---------- hero ---------- */
  #bk-lp .bk-hero{padding:1.75rem 0 2.5rem;}
  #bk-lp .bk-hero-grid{display:grid;gap:1.75rem;}

  #bk-lp .bk-gal-main{
    position:relative;border:1px solid var(--bk-line);border-radius:1rem;overflow:hidden;
    background:#fff;aspect-ratio:1/1;
  }
  #bk-lp .bk-gal-main img{width:100%;height:100%;object-fit:contain;background:#fff;}
  #bk-lp .bk-flag{
    position:absolute;top:.8rem;left:.8rem;z-index:2;display:flex;flex-direction:column;gap:.4rem;align-items:flex-start;
  }
  #bk-lp .bk-flag span{
    background:var(--bk-ink);color:#fff;font-size:.7rem;font-weight:800;letter-spacing:.06em;
    text-transform:uppercase;padding:.32rem .6rem;border-radius:.4rem;
  }
  #bk-lp .bk-flag span.bk-flag-o{background:var(--bk-accent);color:#fff;}
  #bk-lp .bk-flag span.bk-flag-r{background:var(--bk-red);}
  #bk-lp .bk-thumbs{display:flex;gap:.5rem;margin-top:.6rem;overflow-x:auto;padding-bottom:.2rem;scrollbar-width:thin;}
  #bk-lp .bk-thumbs button{
    flex:0 0 4.25rem;height:4.25rem;border-radius:.6rem;overflow:hidden;
    border:2px solid var(--bk-line);background:#fff;transition:border-color .2s;
  }
  #bk-lp .bk-thumbs button.is-on{border-color:var(--bk-ink);}
  #bk-lp .bk-thumbs img{width:100%;height:100%;object-fit:contain;}

  /* faixa de specs do hero */
  #bk-lp .bk-spec-strip{
    display:grid;grid-template-columns:repeat(4,1fr);margin-top:.75rem;
    border:1px solid var(--bk-line);border-radius:.8rem;overflow:hidden;background:#fff;
  }
  #bk-lp .bk-spec-strip div{padding:.75rem .4rem;text-align:center;border-right:1px solid var(--bk-line);}
  #bk-lp .bk-spec-strip div:last-child{border-right:0;}
  #bk-lp .bk-spec-strip b{display:block;font-size:1.05rem;font-weight:800;line-height:1.1;letter-spacing:-.02em;}
  #bk-lp .bk-spec-strip span{font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--bk-muted);}

  #bk-lp .bk-buybox{display:flex;flex-direction:column;gap:1.1rem;}
  #bk-lp .bk-stars{display:flex;align-items:center;gap:.4rem;font-size:.85rem;color:var(--bk-muted);flex-wrap:wrap;}
  #bk-lp .bk-stars svg{width:1rem;height:1rem;fill:var(--bk-accent);}
  #bk-lp .bk-h1{font-size:1.6rem;font-weight:800;line-height:1.22;letter-spacing:-.025em;}
  #bk-lp .bk-kicker{font-size:.95rem;color:var(--bk-muted);}

  #bk-lp .bk-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:.55rem;}
  #bk-lp .bk-price-now{font-size:2.1rem;font-weight:800;letter-spacing:-.03em;line-height:1;}
  #bk-lp .bk-price-was{font-size:1rem;color:var(--bk-muted);text-decoration:line-through;}
  #bk-lp .bk-price-off{
    background:#FEF3F2;color:var(--bk-red);font-size:.78rem;font-weight:800;
    padding:.2rem .5rem;border-radius:.35rem;
  }
  #bk-lp .bk-pay{font-size:.9rem;color:var(--bk-muted);}
  #bk-lp .bk-pay b{color:var(--bk-ink);}

  #bk-lp .bk-opt-label{font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem;}
  #bk-lp .bk-opt-label i{font-style:normal;color:var(--bk-muted);font-weight:600;text-transform:none;letter-spacing:0;}
  #bk-lp .bk-variants{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;}
  #bk-lp .bk-variants input{position:absolute;opacity:0;pointer-events:none;}
  #bk-lp .bk-variants label{
    display:flex;align-items:center;gap:.6rem;padding:.6rem;border:2px solid var(--bk-line);
    border-radius:.7rem;cursor:pointer;transition:border-color .2s,background .2s;font-size:.86rem;font-weight:600;
  }
  #bk-lp .bk-variants input:checked + label{border-color:var(--bk-ink);background:#fff;}
  #bk-lp .bk-variants input:disabled + label{opacity:.4;cursor:not-allowed;text-decoration:line-through;}
  #bk-lp .bk-variants label img{width:2.4rem;height:2.4rem;border-radius:.45rem;object-fit:cover;flex-shrink:0;}

  #bk-lp .bk-qty-row{display:flex;gap:.55rem;align-items:stretch;flex-wrap:wrap;}
  #bk-lp .bk-stepper{display:flex;align-items:center;border:2px solid var(--bk-line);border-radius:.7rem;overflow:hidden;}
  #bk-lp .bk-stepper button{width:2.6rem;font-size:1.15rem;font-weight:700;color:var(--bk-muted);}
  #bk-lp .bk-stepper input{
    width:3.2rem;text-align:center;border:0;font-size:1rem;font-weight:700;
    background:transparent;color:var(--bk-ink);-moz-appearance:textfield;padding:.6rem 0;
  }
  #bk-lp .bk-stepper input::-webkit-outer-spin-button,
  #bk-lp .bk-stepper input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  #bk-lp .bk-presets{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center;}
  #bk-lp .bk-presets button{
    border:1px solid var(--bk-line);border-radius:.5rem;padding:.4rem .6rem;
    font-size:.78rem;font-weight:700;color:var(--bk-muted);transition:all .2s;
  }
  #bk-lp .bk-presets button:hover{border-color:var(--bk-ink);color:var(--bk-ink);}

  #bk-lp .bk-tier-note{
    display:none;background:#FFF7ED;border:1px solid #FED7AA;color:#9A3412;
    border-radius:.6rem;padding:.6rem .75rem;font-size:.85rem;font-weight:600;
  }
  #bk-lp .bk-tier-note.is-on{display:block;}

  #bk-lp .bk-buy{
    display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;
    background:var(--bk-buy);color:#fff;font-size:1.05rem;font-weight:800;letter-spacing:.01em;
    padding:1.05rem 1.25rem;border-radius:.8rem;box-shadow:0 8px 22px rgba(18,161,80,.28);
    transition:background .2s,transform .15s,box-shadow .2s;text-align:center;
  }
  #bk-lp .bk-buy:hover{background:var(--bk-buy-d);transform:translateY(-2px);box-shadow:0 12px 28px rgba(18,161,80,.34);}
  #bk-lp .bk-buy:active{transform:translateY(0);}
  #bk-lp .bk-buy[disabled]{background:#98A2B3;box-shadow:none;cursor:not-allowed;transform:none;}
  #bk-lp .bk-buy svg{width:1.25rem;height:1.25rem;flex-shrink:0;}
  #bk-lp .bk-buy-alt{
    display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;
    border:2px solid var(--bk-line);border-radius:.8rem;padding:.8rem;font-weight:700;font-size:.92rem;
    transition:border-color .2s;
  }
  #bk-lp .bk-buy-alt:hover{border-color:#25D366;}
  #bk-lp .bk-buy-alt svg{width:1.15rem;height:1.15rem;fill:#25D366;flex-shrink:0;}

  #bk-lp .bk-assur{display:grid;gap:.5rem;padding-top:.35rem;}
  #bk-lp .bk-assur li{display:flex;gap:.55rem;align-items:flex-start;font-size:.86rem;color:var(--bk-muted);}
  #bk-lp .bk-assur svg{width:1.05rem;height:1.05rem;flex-shrink:0;margin-top:.15rem;stroke:var(--bk-buy);fill:none;stroke-width:2.4;}
  #bk-lp .bk-assur b{color:var(--bk-ink);font-weight:700;}

  /* ---------- selos ---------- */
  #bk-lp .bk-trust{border-top:1px solid var(--bk-line);border-bottom:1px solid var(--bk-line);padding:1.4rem 0;}
  #bk-lp .bk-trust-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;}
  #bk-lp .bk-trust-item{display:flex;gap:.65rem;align-items:flex-start;}
  #bk-lp .bk-trust-item svg{width:1.4rem;height:1.4rem;flex-shrink:0;stroke:var(--bk-ink);fill:none;stroke-width:1.8;}
  #bk-lp .bk-trust-item b{display:block;font-size:.86rem;font-weight:800;}
  #bk-lp .bk-trust-item span{font-size:.78rem;color:var(--bk-muted);}

  /* ---------- dor / solucao ---------- */
  #bk-lp .bk-pain{display:grid;gap:1rem;}
  #bk-lp .bk-pain-card{border:1px solid var(--bk-line);border-radius:1rem;padding:1.35rem;background:#fff;}
  #bk-lp .bk-pain-card .bk-ico{
    width:2.6rem;height:2.6rem;border-radius:.7rem;background:var(--bk-accent);
    display:flex;align-items:center;justify-content:center;margin-bottom:.9rem;
  }
  #bk-lp .bk-pain-card .bk-ico svg{width:1.35rem;height:1.35rem;stroke:#fff;fill:none;stroke-width:2;}
  #bk-lp .bk-pain-card h3{font-size:1.02rem;font-weight:800;margin-bottom:.45rem;}
  #bk-lp .bk-pain-card p{font-size:.92rem;color:var(--bk-muted);}

  /* ---------- economia ---------- */
  #bk-lp .bk-eco-grid{display:grid;gap:1.6rem;align-items:center;}
  #bk-lp .bk-bars{display:grid;gap:.9rem;}
  #bk-lp .bk-bar-row .bk-bar-top{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.3rem;gap:.6rem;}
  #bk-lp .bk-bar-row b{font-size:.88rem;font-weight:700;}
  #bk-lp .bk-bar-row i{font-style:normal;font-size:.92rem;font-weight:800;white-space:nowrap;}
  #bk-lp .bk-bar-track2{height:.7rem;border-radius:.35rem;background:rgba(255,255,255,.12);overflow:hidden;}
  #bk-lp .bk-bar-fill{
    height:100%;border-radius:.35rem;background:#98A2B3;width:0;
    transition:width 1.1s cubic-bezier(.2,.7,.3,1);
  }
  #bk-lp .is-in .bk-bar-fill{width:var(--w);}
  #bk-lp .bk-bar-row.bk-me .bk-bar-fill{background:var(--bk-accent);}
  #bk-lp .bk-bar-row.bk-me i{color:var(--bk-accent);}
  #bk-lp .bk-eco-note{margin-top:1.1rem;font-size:.78rem;color:rgba(255,255,255,.55);}
  #bk-lp .bk-eco-card{
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);
    border-radius:1rem;padding:1.5rem;
  }
  #bk-lp .bk-eco-card h3{font-size:1.15rem;font-weight:800;margin-bottom:.9rem;}
  #bk-lp .bk-eco-card ul{display:grid;gap:.7rem;}
  #bk-lp .bk-eco-card li{
    display:flex;justify-content:space-between;gap:1rem;font-size:.9rem;color:rgba(255,255,255,.78);
    border-bottom:1px dashed rgba(255,255,255,.14);padding-bottom:.7rem;
  }
  #bk-lp .bk-eco-card li:last-child{border-bottom:0;padding-bottom:0;}
  #bk-lp .bk-eco-card li b{color:#fff;font-weight:800;white-space:nowrap;}
  #bk-lp .bk-eco-hl{
    margin-top:1.1rem;background:var(--bk-accent);color:#fff;border-radius:.7rem;
    padding:.9rem 1rem;font-size:.9rem;font-weight:700;
  }

  /* ---------- destaques ---------- */
  #bk-lp .bk-feats{display:grid;gap:.9rem;}
  #bk-lp .bk-feat{
    border:1px solid var(--bk-line);border-radius:1rem;padding:1.2rem;background:#fff;
    display:flex;gap:.9rem;align-items:flex-start;
  }
  #bk-lp .bk-feat svg{width:1.6rem;height:1.6rem;flex-shrink:0;stroke:var(--bk-accent);fill:none;stroke-width:1.9;margin-top:.1rem;}
  #bk-lp .bk-feat h3{font-size:.98rem;font-weight:800;margin-bottom:.3rem;}
  #bk-lp .bk-feat p{font-size:.88rem;color:var(--bk-muted);}

  /* ---------- specs ---------- */
  #bk-lp .bk-specs{border:1px solid var(--bk-line);border-radius:1rem;overflow:hidden;background:#fff;}
  #bk-lp .bk-specs tr{border-bottom:1px solid var(--bk-line);}
  #bk-lp .bk-specs tr:last-child{border-bottom:0;}
  #bk-lp .bk-specs th{
    text-align:left;padding:.85rem 1rem;font-size:.8rem;font-weight:800;text-transform:uppercase;
    letter-spacing:.06em;color:var(--bk-muted);width:46%;vertical-align:top;
  }
  #bk-lp .bk-specs td{padding:.85rem 1rem;font-size:.92rem;font-weight:600;}

  /* ---------- comparativo ---------- */
  #bk-lp .bk-vs-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  #bk-lp .bk-vs{border:1px solid var(--bk-line);border-radius:1rem;overflow:hidden;background:#fff;min-width:34rem;}
  #bk-lp .bk-vs thead th{
    background:var(--bk-soft);padding:.85rem .7rem;font-size:.76rem;font-weight:800;
    text-transform:uppercase;letter-spacing:.05em;text-align:center;
  }
  #bk-lp .bk-vs thead th:first-child{text-align:left;}
  #bk-lp .bk-vs thead th.bk-vs-me{background:var(--bk-accent);color:#fff;}
  #bk-lp .bk-vs td{padding:.8rem .7rem;font-size:.86rem;border-top:1px solid var(--bk-line);text-align:center;}
  #bk-lp .bk-vs td:first-child{text-align:left;font-weight:600;}
  #bk-lp .bk-yes{color:var(--bk-buy);font-weight:800;}
  #bk-lp .bk-no{color:#98A2B3;font-weight:800;}

  /* ---------- atacado ---------- */
  #bk-lp .bk-tiers{display:grid;gap:.7rem;}
  #bk-lp .bk-tier{
    display:flex;align-items:center;justify-content:space-between;gap:1rem;
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
    border-radius:.8rem;padding:.95rem 1.1rem;
  }
  #bk-lp .bk-tier.bk-tier-best{border-color:var(--bk-accent);background:rgba(255,114,0,.12);}
  #bk-lp .bk-tier-q{font-size:.92rem;font-weight:700;}
  #bk-lp .bk-tier-q small{display:block;font-size:.74rem;font-weight:500;color:rgba(255,255,255,.6);}
  #bk-lp .bk-tier-p{font-size:1.25rem;font-weight:800;color:var(--bk-accent);white-space:nowrap;text-align:right;}
  #bk-lp .bk-tier-p small{display:block;font-size:.7rem;font-weight:600;color:rgba(255,255,255,.6);}
  #bk-lp .bk-tier-cta{margin-top:1.4rem;display:grid;gap:.6rem;}

  /* ---------- garantia ---------- */
  #bk-lp .bk-guard{border:2px dashed var(--bk-line);border-radius:1.1rem;padding:1.75rem;text-align:center;background:#fff;}
  #bk-lp .bk-guard .bk-seal{
    width:3.4rem;height:3.4rem;margin:0 auto .9rem;border-radius:50%;background:var(--bk-buy);
    display:flex;align-items:center;justify-content:center;
  }
  #bk-lp .bk-guard .bk-seal svg{width:1.7rem;height:1.7rem;stroke:#fff;fill:none;stroke-width:2.4;}
  #bk-lp .bk-guard h2{font-size:1.3rem;font-weight:800;margin-bottom:.6rem;}
  #bk-lp .bk-guard p{color:var(--bk-muted);font-size:.95rem;max-width:34rem;margin:0 auto;}

  /* ---------- faq ---------- */
  #bk-lp .bk-faq{display:grid;gap:.6rem;}
  #bk-lp .bk-faq-item{border:1px solid var(--bk-line);border-radius:.8rem;background:#fff;overflow:hidden;}
  #bk-lp .bk-faq-q{
    display:flex;width:100%;align-items:center;justify-content:space-between;gap:1rem;
    padding:1rem 1.1rem;text-align:left;font-weight:700;font-size:.95rem;
  }
  #bk-lp .bk-faq-q svg{width:1.1rem;height:1.1rem;flex-shrink:0;stroke:var(--bk-muted);fill:none;stroke-width:2.4;transition:transform .25s;}
  #bk-lp .bk-faq-item.is-on .bk-faq-q svg{transform:rotate(180deg);}
  #bk-lp .bk-faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  #bk-lp .bk-faq-a p{padding:0 1.1rem 1.1rem;color:var(--bk-muted);font-size:.92rem;}

  /* ---------- cta final ---------- */
  #bk-lp .bk-final{text-align:center;}
  #bk-lp .bk-final h2{font-size:1.6rem;font-weight:800;line-height:1.2;margin-bottom:.6rem;}
  #bk-lp .bk-final p{color:rgba(255,255,255,.7);margin-bottom:1.5rem;}
  #bk-lp .bk-final .bk-buy{max-width:26rem;margin:0 auto;}
  #bk-lp .bk-final-note{margin-top:.9rem;font-size:.8rem;color:rgba(255,255,255,.55);}

  /* ---------- sticky ---------- */
  #bk-lp .bk-sticky{
    position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(255,255,255,.97);
    backdrop-filter:blur(10px);border-top:1px solid var(--bk-line);padding:.6rem .9rem;
    display:flex;align-items:center;gap:.8rem;transform:translateY(110%);transition:transform .3s ease;
    box-shadow:0 -4px 20px rgba(0,0,0,.08);
  }
  #bk-lp .bk-sticky.is-on{transform:translateY(0);}
  #bk-lp .bk-sticky-info{flex:1;min-width:0;}
  #bk-lp .bk-sticky-info b{display:block;font-size:1.05rem;font-weight:800;line-height:1.1;}
  #bk-lp .bk-sticky-info span{font-size:.72rem;color:var(--bk-muted);}
  #bk-lp .bk-sticky .bk-buy{width:auto;padding:.85rem 1.4rem;font-size:.95rem;}

  /* ---------- reveal ---------- */
  #bk-lp .bk-rev{opacity:0;transform:translateY(1.4rem);transition:opacity .55s ease,transform .55s ease;}
  #bk-lp .bk-rev.is-in{opacity:1;transform:none;}

  /* ================= 640px ================= */
  @media (min-width:640px){
    #bk-lp .bk-h1{font-size:1.9rem;}
    #bk-lp .bk-h2{font-size:2rem;}
    #bk-lp .bk-trust-grid{grid-template-columns:repeat(4,1fr);}
    #bk-lp .bk-pain{grid-template-columns:repeat(3,1fr);}
    #bk-lp .bk-feats{grid-template-columns:repeat(2,1fr);}
    #bk-lp .bk-final h2{font-size:2.1rem;}
    #bk-lp .bk-spec-strip b{font-size:1.2rem;}
  }

  /* ================= 900px ================= */
  @media (min-width:900px){
    #bk-lp .bk-sec{padding:4.5rem 0;}
    #bk-lp .bk-hero{padding:2.25rem 0 3.25rem;}
    #bk-lp .bk-hero-grid{grid-template-columns:1.05fr .95fr;gap:3rem;align-items:start;}
    #bk-lp .bk-buybox{position:sticky;top:1.5rem;}
    #bk-lp .bk-h1{font-size:2.15rem;}
    #bk-lp .bk-h2{font-size:2.3rem;}
    #bk-lp .bk-eco-grid{grid-template-columns:1.1fr .9fr;gap:3rem;}
    #bk-lp .bk-feats{grid-template-columns:repeat(3,1fr);}
    #bk-lp .bk-tiers{grid-template-columns:repeat(2,1fr);}
    #bk-lp .bk-vs{min-width:0;}
    #bk-lp .bk-sticky{display:none;}
  }
</style>

<div id="bk-lp">

  <!-- ============ BARRA TOPO ============ -->
  <div class="bk-bar">
    <div class="bk-bar-track">
      {%- for pass in (1..2) -%}
      <span>⚡ MOTOR <b>750W</b> COM BATERIA DE LÍTIO 48V</span><span>🔋 ATÉ <b>50 KM</b> POR CARGA</span><span>🛵 <b>SEM CNH, SEM EMPLACAMENTO, SEM GASOLINA</b></span><span>💳 <b>12X NO CARTÃO</b> OU PIX COM DESCONTO</span><span>🏷️ <b>ATACADO A PARTIR DE 3 PEÇAS</b></span><span>🛡️ <b>TROCA GARANTIDA</b> SEM BUROCRACIA</span>
      {%- endfor -%}
    </div>
  </div>

  <!-- ============ HERO + COMPRA ============ -->
  <section class="bk-hero">
    <div class="bk-wrap">
      <div class="bk-hero-grid">

        <!-- galeria -->
        <div>
          <div class="bk-gal-main">
            <div class="bk-flag">
              <span class="bk-flag-o">750W · 48V</span>
              {%- if v.compare_at_price > v.price -%}
                {%- assign off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
                <span class="bk-flag-r">-{{ off }}% OFF</span>
              {%- endif -%}
              {%- if v.available -%}
                <span>Pronta entrega</span>
              {%- endif -%}
            </div>
            {%- if product.media.size > 0 -%}
              <img id="bk-hero-img" src="{{ product.featured_media | img_url: '1200x' }}" alt="{{ product.title | escape }}" width="1200" height="1200" loading="eager">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
          <div class="bk-thumbs">
            {%- for media in product.media -%}
              <button type="button" class="{% if forloop.first %}is-on{% endif %}" data-full="{{ media | img_url: '1200x' }}" aria-label="Foto {{ forloop.index }}">
                <img src="{{ media | img_url: '160x' }}" alt="" loading="lazy" width="80" height="80">
              </button>
            {%- endfor -%}
          </div>
          {%- endif -%}

          <div class="bk-spec-strip">
            <div><b>750W</b><span>Motor</span></div>
            <div><b>48V</b><span>18,2Ah lítio</span></div>
            <div><b>50 km</b><span>Autonomia</span></div>
            <div><b>32 km/h</b><span>Velocidade</span></div>
          </div>
        </div>

        <!-- caixa de compra -->
        <div class="bk-buybox">

          <div class="bk-stars">
            {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg>{%- endfor -%}
            <span>Vendido e enviado por <b>{{ shop.name }}</b></span>
          </div>

          <h1 class="bk-h1">Bicicleta Elétrica {{ modelo }} — Bateria de Lítio 48V, até 50&nbsp;km de autonomia</h1>

          <p class="bk-kicker">Sai de casa, atravessa a cidade e volta gastando menos de R$&nbsp;1 de energia. Pneus largos, freios a disco nas duas rodas e banco largo estilo moto — conforto de motocicleta com o custo de uma bicicleta.</p>

          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="bk-form">

            <div class="bk-price">
              <span class="bk-price-now" id="bk-price-now">{{ unit | money }}</span>
              {%- if v.compare_at_price > v.price -%}
                <span class="bk-price-was" id="bk-price-was">{{ v.compare_at_price | money }}</span>
                <span class="bk-price-off">ECONOMIZE {{ v.compare_at_price | minus: v.price | money }}</span>
              {%- endif -%}
            </div>
            <p class="bk-pay" style="margin-bottom:1.1rem;">
              <b>{{ pix | money }}</b> no Pix (5% off) &nbsp;·&nbsp; ou 12x de <b>{{ parcela | money }}</b> no cartão
            </p>

            {%- unless product.has_only_default_variant -%}
              <div style="margin-bottom:1.1rem;">
                <p class="bk-opt-label">Escolha a cor <i>— mesma potência, mesma bateria</i></p>
                <div class="bk-variants">
                  {%- for variant in product.variants -%}
                    {%- if variant.image -%}
                      {%- assign variant_img = variant.image | img_url: '1200x' -%}
                    {%- else -%}
                      {%- assign variant_img = product.featured_media | img_url: '1200x' -%}
                    {%- endif -%}
                    <input type="radio" name="id" id="bk-v-{{ variant.id }}" value="{{ variant.id }}"
                           data-price="{{ variant.price | money }}"
                           data-img="{{ variant_img }}"
                           {% if variant == v %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    <label for="bk-v-{{ variant.id }}">
                      {%- if variant.image -%}<img src="{{ variant.image | img_url: '120x' }}" alt="" loading="lazy">{%- endif -%}
                      <span>{{ variant.title }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <input type="hidden" name="id" value="{{ v.id }}">
            {%- endunless -%}

            <div style="margin-bottom:1.1rem;">
              <p class="bk-opt-label">Quantidade <i>— 3 unidades já libera o preço de atacado</i></p>
              <div class="bk-qty-row">
                <div class="bk-stepper">
                  <button type="button" data-step="-1" aria-label="Diminuir">−</button>
                  <input type="number" name="quantity" id="bk-qty" value="1" min="1" step="1">
                  <button type="button" data-step="1" aria-label="Aumentar">+</button>
                </div>
                <div class="bk-presets">
                  <button type="button" data-set="3">3 un</button>
                  <button type="button" data-set="10">10 un</button>
                  <button type="button" data-set="30">30 un</button>
                </div>
              </div>
              <p class="bk-tier-note" id="bk-tier-note" style="margin-top:.6rem;"></p>
            </div>

            <button type="submit" class="bk-buy" {% unless v.available %}disabled{% endunless %}>
              {%- if v.available -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
                COMPRAR AGORA
              {%- else -%}
                PRODUTO ESGOTADO
              {%- endif -%}
            </button>
          </form>

          <a href="{{ wa }}" class="bk-buy-alt" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2z"/></svg>
            Tirar dúvida com um vendedor no WhatsApp
          </a>

          <ul class="bk-assur">
            <li><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Compra 100% segura</b> — ambiente criptografado, Pix, boleto e cartão.</span></li>
            <li><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Despacho em até 48h</b> com código de rastreio no WhatsApp.</span></li>
            <li><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Chegou com avaria? A gente resolve.</b> Sem burocracia, sem discussão.</span></li>
            <li><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Vai revender?</b> A partir de 3 unidades o preço cai para {{ p3 | money }}.</span></li>
          </ul>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ SELOS ============ -->
  <div class="bk-trust">
    <div class="bk-wrap">
      <div class="bk-trust-grid">
        <div class="bk-trust-item">
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
