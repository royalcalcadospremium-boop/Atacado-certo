<script>
(function(){
  var root = document.getElementById('protek-lp');
  if(!root) return;

  /* FAQ acordeão */
  root.querySelectorAll('.pk-faq-q').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.parentElement;
      var panel = item.querySelector('.pk-faq-a');
      var open = item.classList.contains('pk-open');
      root.querySelectorAll('.pk-faq-item.pk-open').forEach(function(o){
        o.classList.remove('pk-open');
        o.querySelector('.pk-faq-a').style.maxHeight = '0px';
      });
      if(!open){
        item.classList.add('pk-open');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });

  /* Reveal ao rolar */
  var els = root.querySelectorAll('.pk-reveal');
  if(!('IntersectionObserver' in window)){
    els.forEach(function(el){ el.classList.add('pk-in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('pk-in'); io.unobserve(e.target); }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  els.forEach(function(el){ io.observe(el); });

  /* Vídeos: garante autoplay silencioso no mobile */
  root.querySelectorAll('video').forEach(function(v){
    v.muted = true;
    var p = v.play();
    if(p && p.catch){ p.catch(function(){}); }
  });
})();
</script>

