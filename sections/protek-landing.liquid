<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">

<style>
  #protek-lp{
    --pk-primary:#FF8C42;
    --pk-fg:#1A1A1A;
    --pk-muted:#666666;
    --pk-gray50:#F9FAFB;
    --pk-border:#E5E7EB;
    --pk-orange50:#FFF7ED;
    --pk-orange200:#FED7AA;

    font-family:'Roboto',ui-sans-serif,system-ui,sans-serif;
    color:var(--pk-fg);
    background:#fff;
    line-height:1.5;
    overflow-x:hidden;
    width:100%;
    max-width:100vw;
  }
  #protek-lp *,#protek-lp *::before,#protek-lp *::after{box-sizing:border-box;}
  #protek-lp p,#protek-lp h1,#protek-lp h2,#protek-lp h3,#protek-lp h4,#protek-lp ul,#protek-lp li{margin:0;padding:0;}
  #protek-lp ul{list-style:none;}
  #protek-lp img,#protek-lp video{display:block;max-width:100%;}
  #protek-lp button{font-family:inherit;border:0;cursor:pointer;}
  #protek-lp a{text-decoration:none;}

  #protek-lp .pk-container{width:100%;margin:0 auto;padding:0 1rem;}
  #protek-lp .pk-mw-7xl{max-width:80rem;}
  #protek-lp .pk-mw-6xl{max-width:72rem;}
  #protek-lp .pk-mw-5xl{max-width:64rem;}
  #protek-lp .pk-mw-3xl{max-width:48rem;}
  #protek-lp .pk-section{width:100%;max-width:100vw;overflow-x:hidden;}
  #protek-lp .pk-bg-gray{background:var(--pk-gray50);}
  #protek-lp .pk-only-mobile{display:block;}
  #protek-lp .pk-only-desktop{display:none;}

  /* ---------- reveal ---------- */
  #protek-lp .pk-reveal{opacity:0;transform:translateY(3rem);transition:opacity .7s ease-out,transform .7s ease-out;}
  #protek-lp .pk-reveal.pk-in{opacity:1;transform:translateY(0);}

  /* ---------- marquee topo ---------- */
  #protek-lp .pk-marquee{
    position:relative;width:100%;overflow:hidden;
    background:linear-gradient(to right,var(--pk-primary),rgba(255,140,66,.9),var(--pk-primary));
    color:#fff;padding:.5rem 0;
  }
  #protek-lp .pk-marquee-track{
    display:inline-block;white-space:nowrap;padding-right:3rem;
    animation:pk-marquee 45s linear infinite;will-change:transform;
  }
  #protek-lp .pk-marquee-track:hover{animation-play-state:paused;}
  #protek-lp .pk-marquee-track span{
    font-family:'Montserrat',sans-serif;font-weight:900;text-transform:uppercase;
    letter-spacing:.1em;font-size:.75rem;display:inline-block;
  }
  @keyframes pk-marquee{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

  /* ---------- hero ---------- */
  #protek-lp .pk-hero{position:relative;background:#fff;padding:3rem 0 5rem;margin-top:1.5rem;}
  #protek-lp .pk-hero-glow{position:absolute;inset:0;opacity:.05;overflow:hidden;pointer-events:none;}
  #protek-lp .pk-hero-glow i{position:absolute;width:18rem;height:18rem;background:var(--pk-primary);border-radius:9999px;filter:blur(64px);mix-blend-mode:multiply;}
  #protek-lp .pk-hero-glow i:first-child{top:5rem;right:2.5rem;}
  #protek-lp .pk-hero-glow i:last-child{bottom:5rem;left:2.5rem;opacity:.3;}
  #protek-lp .pk-hero-grid{position:relative;z-index:1;display:grid;gap:2rem;align-items:center;}
  #protek-lp .pk-hero-copy{display:flex;flex-direction:column;align-items:center;gap:1.5rem;width:100%;}
  #protek-lp .pk-h1{
    font-size:2.25rem;font-weight:800;line-height:1.1;text-align:center;
    text-transform:capitalize;max-width:42rem;color:var(--pk-fg);
  }
  #protek-lp .pk-h1 span{color:var(--pk-primary);}
  #protek-lp .pk-promo-mobile{
    font-size:1.125rem;color:var(--pk-muted);line-height:1.625;text-align:center;
    background:var(--pk-orange50);border:1px solid var(--pk-orange200);border-radius:1rem;padding:1.5rem;
  }
  #protek-lp .pk-hero-video-mobile{width:100%;max-width:20rem;height:24rem;overflow:hidden;border-radius:1rem;filter:drop-shadow(0 25px 25px rgba(0,0,0,.15));margin:0 auto;}
  #protek-lp .pk-hero-video-mobile video{width:100%;height:100%;object-fit:cover;object-position:center top;}
  #protek-lp .pk-hero-video-desktop{position:relative;height:500px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  #protek-lp .pk-hero-video-desktop video{width:90%;height:100%;object-fit:cover;object-position:center bottom;filter:drop-shadow(0 25px 25px rgba(0,0,0,.15));transition:transform .7s;}
  #protek-lp .pk-hero-video-desktop video:hover{transform:scale(1.05);}
  #protek-lp .pk-rating{display:flex;flex-direction:column;align-items:center;gap:.5rem;}
  #protek-lp .pk-stars{display:flex;align-items:center;gap:.25rem;justify-content:center;}
  #protek-lp .pk-stars svg{width:1.25rem;height:1.25rem;color:var(--pk-primary);fill:var(--pk-primary);}
  #protek-lp .pk-rating b{font-weight:700;margin-left:.5rem;font-size:1.125rem;color:var(--pk-primary);}
  #protek-lp .pk-rating small{color:var(--pk-muted);font-size:.875rem;font-weight:500;}
  #protek-lp .pk-promo-desktop{font-size:1.25rem;color:var(--pk-muted);line-height:1.625;max-width:42rem;}
  #protek-lp .pk-warning{font-size:1.125rem;font-weight:500;color:var(--pk-fg);}
  #protek-lp .pk-cta-card{
    position:relative;padding:2rem;border-radius:1.5rem;overflow:hidden;
    background:linear-gradient(to bottom right,rgba(255,255,255,.8),#fff);
    box-shadow:0 25px 50px -12px rgba(0,0,0,.25);border:1px solid rgba(255,140,66,.2);
  }

  /* ---------- botões ---------- */
  #protek-lp .pk-btn{
    display:inline-flex;align-items:center;justify-content:center;gap:.25rem;white-space:nowrap;
    font-family:'Montserrat',sans-serif;background:var(--pk-primary);color:#fff;
    border-radius:9999px;font-weight:700;transition:all .3s ease;
  }
  #protek-lp .pk-btn:hover{background:#f97d2c;transform:translateY(-4px);}
  #protek-lp .pk-btn svg{width:1.5rem;height:1.5rem;margin-left:.5rem;}
  #protek-lp .pk-btn-hero-mobile{width:100%;padding:1.75rem 2.5rem;font-size:1.25rem;box-shadow:0 8px 30px rgba(255,140,66,.3);}
  #protek-lp .pk-btn-hero-mobile:hover{box-shadow:0 8px 40px rgba(255,140,66,.4);}
  #protek-lp .pk-btn-hero{
    position:relative;z-index:1;width:100%;padding:2rem 3rem;font-size:1.5rem;font-weight:800;
    background:linear-gradient(to right,var(--pk-primary),var(--pk-primary));
    box-shadow:0 10px 40px rgba(255,140,66,.4);transition:all .5s ease-in-out;
  }
  #protek-lp .pk-btn-hero:hover{box-shadow:0 12px 50px rgba(255,140,66,.6);transform:translateY(-8px) scale(1.03) rotate(1deg);}
  #protek-lp .pk-btn-hero svg{width:1.75rem;height:1.75rem;margin-left:.75rem;}

  /* ---------- carrossel de depoimentos em vídeo ---------- */
  #protek-lp .pk-proof{padding:.125rem 0;background:#fff;}
  #protek-lp .pk-proof-head{text-align:center;margin-bottom:1rem;}
  #protek-lp .pk-h2{font-family:'Roboto',sans-serif;font-size:1.5rem;font-weight:800;color:var(--pk-fg);}
  #protek-lp .pk-h2 span{color:var(--pk-primary);}
  #protek-lp .pk-proof-viewport{overflow:hidden;border-radius:1rem;width:100%;}
  #protek-lp .pk-proof-track{display:flex;gap:.5rem;padding:0 .5rem;animation:pk-scroll 18s linear infinite;width:max-content;}
  #protek-lp .pk-proof-track:hover{animation-play-state:paused;}
  #protek-lp .pk-proof-item{flex-shrink:0;width:12rem;height:16rem;border-radius:.75rem;overflow:hidden;box-shadow:0 10px 15px -3px rgba(0,0,0,.1);}
  #protek-lp .pk-proof-item video{width:100%;height:100%;object-fit:cover;}
  @keyframes pk-scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

  /* ---------- features ---------- */
  #protek-lp .pk-features{padding:41px 0;}
  #protek-lp .pk-features-grid{display:grid;gap:4rem;align-items:center;}
  #protek-lp .pk-features-img{position:relative;}
  #protek-lp .pk-features-img::before{content:"";position:absolute;inset:0;background:rgba(255,140,66,.1);border-radius:3rem;transform:rotate(-3deg) scale(1.05);z-index:0;}
  #protek-lp .pk-features-img img{position:relative;width:100%;border-radius:1.5rem;box-shadow:0 20px 25px -5px rgba(0,0,0,.1);}
  #protek-lp .pk-features-copy{display:flex;flex-direction:column;gap:2rem;}
  #protek-lp .pk-h2-lg{font-size:1.875rem;font-weight:800;color:var(--pk-fg);margin-bottom:1rem;}
  #protek-lp .pk-lead{font-size:1.125rem;color:var(--pk-muted);}
  #protek-lp .pk-feature-list{display:flex;flex-direction:column;gap:1.5rem;}
  #protek-lp .pk-feature{display:flex;align-items:flex-start;gap:1rem;background:#fff;padding:1rem;border-radius:1rem;box-shadow:0 1px 2px rgba(0,0,0,.05);transition:box-shadow .3s;}
  #protek-lp .pk-feature:hover{box-shadow:0 4px 6px -1px rgba(0,0,0,.1);}
  #protek-lp .pk-feature-icon{background:rgba(255,140,66,.2);padding:.75rem;border-radius:.75rem;flex-shrink:0;display:flex;}
  #protek-lp .pk-feature-icon svg{width:1.5rem;height:1.5rem;color:var(--pk-primary);}
  #protek-lp .pk-feature span{font-weight:700;font-size:1.125rem;padding-top:.25rem;color:var(--pk-fg);}

  /* ---------- detalhes ---------- */
  #protek-lp .pk-details{padding:50px 0;background:#fff;}
  #protek-lp .pk-details-head{text-align:center;max-width:48rem;margin:0 auto 5rem;}
  #protek-lp .pk-details-head h2{font-size:1.875rem;font-weight:800;color:var(--pk-fg);margin-bottom:1.5rem;}
  #protek-lp .pk-details-head p{font-size:1.25rem;color:var(--pk-muted);}
  #protek-lp .pk-detail-blocks{display:flex;flex-direction:column;gap:6rem;}
  #protek-lp .pk-detail{display:grid;gap:3rem;align-items:center;}
  #protek-lp .pk-detail h3{font-size:1.5rem;font-weight:700;color:var(--pk-fg);margin-bottom:1.5rem;}
  #protek-lp .pk-detail p{font-size:1.125rem;color:var(--pk-muted);line-height:1.625;}
  #protek-lp .pk-detail-img{width:100%;aspect-ratio:1/1;border-radius:1.5rem;overflow:hidden;box-shadow:0 25px 50px -12px rgba(0,0,0,.25);}
  #protek-lp .pk-detail-img img{width:100%;height:100%;object-fit:cover;}

  /* ---------- bônus ---------- */
  #protek-lp .pk-bonus{padding:45px 0;}
  #protek-lp .pk-bonus-card{background:#fff;border-radius:2rem;padding:2rem;box-shadow:0 20px 25px -5px rgba(0,0,0,.1);border:1px solid rgba(229,231,235,.5);}
  #protek-lp .pk-bonus-grid{display:grid;gap:3rem;align-items:center;}
  #protek-lp .pk-badge{display:inline-block;background:var(--pk-primary);color:#fff;padding:.375rem 1rem;border-radius:9999px;font-size:.875rem;font-weight:700;letter-spacing:.025em;}
  #protek-lp .pk-bonus h3{font-size:1.5rem;font-weight:700;color:var(--pk-fg);margin:1.5rem 0;}
  #protek-lp .pk-bonus p{color:var(--pk-muted);margin-bottom:1.5rem;}
  #protek-lp .pk-bonus p b{color:var(--pk-fg);font-weight:700;}
  #protek-lp .pk-bonus li{display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem;}
  #protek-lp .pk-bonus li svg{width:1.25rem;height:1.25rem;color:var(--pk-primary);flex-shrink:0;}
  #protek-lp .pk-bonus li span{font-weight:500;color:var(--pk-fg);}
  #protek-lp .pk-bonus-img{position:relative;max-width:24rem;margin:0 auto;}
  #protek-lp .pk-bonus-img img{width:100%;border-radius:1rem;box-shadow:0 10px 15px -3px rgba(0,0,0,.1);transform:rotate(2deg);transition:transform .5s;}
  #protek-lp .pk-bonus-img img:hover{transform:rotate(0deg);}

  /* ---------- CTA grande ---------- */
  #protek-lp .pk-cta{padding:4rem 0;background:#fff;}
  #protek-lp .pk-cta-wrap{display:flex;flex-direction:column;align-items:center;gap:2rem;}
  #protek-lp .pk-cta-glow{position:relative;width:100%;}
  #protek-lp .pk-cta-glow::before{
    content:"";position:absolute;inset:-.25rem;border-radius:9999px;
    background:linear-gradient(to right,#F97316,#FB923C,#F97316);filter:blur(32px);opacity:.75;
    animation:pk-pulse 2s cubic-bezier(.4,0,.6,1) infinite;
  }
  @keyframes pk-pulse{0%,100%{opacity:.75;}50%{opacity:.4;}}
  #protek-lp .pk-btn-cta{
    position:relative;width:100%;padding:1.5rem 2rem;font-size:1.25rem;font-weight:800;
    background:linear-gradient(to right,#F97316,#FB923C,#F97316);color:#fff;border-radius:9999px;
    box-shadow:0 25px 50px -12px rgba(0,0,0,.25);font-family:'Montserrat',sans-serif;
    display:flex;align-items:center;justify-content:center;gap:.75rem;transition:all .3s ease-out;
  }
  #protek-lp .pk-btn-cta:hover{transform:translateY(-4px) scale(1.05);box-shadow:0 20px 60px rgba(249,115,22,.6);}
  #protek-lp .pk-btn-cta:active{transform:scale(.95);}
  #protek-lp .pk-cta-note{text-align:center;font-size:.875rem;color:var(--pk-muted);font-weight:500;letter-spacing:.025em;}

  /* ---------- depoimentos ---------- */
  #protek-lp .pk-reviews{padding:3rem 0;}
  #protek-lp .pk-reviews-head{text-align:center;margin-bottom:4rem;}
  #protek-lp .pk-reviews-head h2{font-size:1.875rem;font-weight:800;color:var(--pk-fg);margin-bottom:1rem;}
  #protek-lp .pk-reviews-head p{font-size:1.25rem;color:var(--pk-muted);}
  #protek-lp .pk-reviews-head p b{color:var(--pk-fg);font-weight:700;}
  #protek-lp .pk-reviews-grid{display:grid;gap:2rem;}
  #protek-lp .pk-review{background:#fff;padding:2rem;border-radius:1.5rem;box-shadow:0 10px 15px -3px rgba(0,0,0,.1);border:1px solid rgba(229,231,235,.5);display:flex;flex-direction:column;}
  #protek-lp .pk-review-top{display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;}
  #protek-lp .pk-review-top img{width:4rem;height:4rem;border-radius:9999px;object-fit:cover;border:2px solid rgba(255,140,66,.2);}
  #protek-lp .pk-review-top h4{font-weight:700;font-size:1.125rem;color:var(--pk-fg);}
  #protek-lp .pk-review-stars{display:flex;gap:.25rem;margin-top:.25rem;}
  #protek-lp .pk-review-stars svg{width:1rem;height:1rem;color:var(--pk-primary);fill:var(--pk-primary);}
  #protek-lp .pk-review p{color:var(--pk-muted);line-height:1.625;font-style:italic;flex-grow:1;}

  /* ---------- FAQ ---------- */
  #protek-lp .pk-faq{padding:3rem 0;background:#fff;}
  #protek-lp .pk-faq-head{text-align:center;margin-bottom:3rem;}
  #protek-lp .pk-faq-head h2{font-size:1.875rem;font-weight:800;color:var(--pk-fg);}
  #protek-lp .pk-faq-list{display:flex;flex-direction:column;gap:1rem;}
  #protek-lp .pk-faq-item{border:1px solid rgba(229,231,235,.6);border-radius:1rem;overflow:hidden;background:#fff;transition:border-color .3s;}
  #protek-lp .pk-faq-item:hover{border-color:rgba(255,140,66,.3);}
  #protek-lp .pk-faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;padding:1.5rem;text-align:left;background:transparent;}
  #protek-lp .pk-faq-q h3{font-size:1.125rem;font-weight:700;color:var(--pk-fg);padding-right:2rem;}
  #protek-lp .pk-faq-icon{padding:.5rem;border-radius:9999px;background:rgba(255,140,66,.1);color:var(--pk-primary);display:flex;transition:transform .3s;}
  #protek-lp .pk-faq-icon svg{width:1.25rem;height:1.25rem;}
  #protek-lp .pk-faq-item.pk-open .pk-faq-icon{transform:rotate(180deg);}
  #protek-lp .pk-faq-a{overflow:hidden;max-height:0;opacity:0;transition:max-height .3s ease-in-out,opacity .3s ease-in-out;}
  #protek-lp .pk-faq-item.pk-open .pk-faq-a{opacity:1;}
  #protek-lp .pk-faq-a div{padding:0 1.5rem 1.5rem;margin:0 1.5rem;color:var(--pk-muted);line-height:1.625;border-top:1px solid rgba(229,231,235,.3);padding-top:1.5rem;}

  /* ---------- garantia ---------- */
  #protek-lp .pk-trust{padding:5rem 0;background:var(--pk-primary);color:#fff;text-align:center;}
  #protek-lp .pk-trust h2{font-size:1.875rem;font-weight:800;margin-bottom:1.5rem;}
  #protek-lp .pk-trust>div>div>p{font-size:1.125rem;color:rgba(255,255,255,.9);margin:0 auto 3rem;max-width:48rem;line-height:1.625;}
  #protek-lp .pk-trust p b{color:#fff;font-weight:700;}
  #protek-lp .pk-trust-grid{display:grid;gap:2rem;}
  #protek-lp .pk-trust-card{display:flex;flex-direction:column;align-items:center;padding:1.5rem;background:rgba(255,255,255,.1);border-radius:1rem;backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.2);}
  #protek-lp .pk-trust-card svg{width:2.5rem;height:2.5rem;margin-bottom:1rem;}
  #protek-lp .pk-trust-card p{font-weight:500;color:rgba(255,255,255,.9);font-size:1rem;margin:0;}

  /* ---------- rodapé opcional ---------- */
  #protek-lp .pk-footer{background:#fff;color:var(--pk-fg);padding:4rem 0;border-top:1px solid var(--pk-border);}
  #protek-lp .pk-footer-grid{display:grid;gap:3rem;margin-bottom:3rem;}
  #protek-lp .pk-footer h3{font-size:1.5rem;font-weight:700;color:var(--pk-primary);margin-bottom:1rem;}
  #protek-lp .pk-footer h4{font-size:1.125rem;font-weight:700;margin-bottom:1rem;}
  #protek-lp .pk-footer p,#protek-lp .pk-footer a,#protek-lp .pk-footer span{color:rgba(26,26,26,.8);line-height:1.625;}
  #protek-lp .pk-footer li{margin-bottom:.75rem;display:flex;align-items:flex-start;gap:.75rem;}
  #protek-lp .pk-footer li svg{width:1.25rem;height:1.25rem;color:var(--pk-primary);flex-shrink:0;}
  #protek-lp .pk-footer a:hover{color:var(--pk-primary);}
  #protek-lp .pk-footer-bottom{border-top:1px solid var(--pk-border);padding-top:2rem;display:flex;flex-direction:column;align-items:center;gap:1rem;}
