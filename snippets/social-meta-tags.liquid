{%- comment -%}
  Open Graph (Facebook, WhatsApp, Pinterest, LinkedIn) e Twitter/X Card.
  Toda página sai com título, descrição, URL e imagem — sem imagem o link
  compartilhado no WhatsApp aparece "pelado". A imagem de fallback é, nesta
  ordem: imagem do produto/artigo/coleção > imagem de compartilhamento da
  página (Shopify > Preferências) > logo da marca.
{%- endcomment -%}

{%- assign og_title = page_title -%}
{%- assign og_type = 'website' -%}
{%- assign og_image = page_image -%}

{%- if request.page_type == 'product' -%}
  {%- assign og_title = product.title -%}
  {%- assign og_type = 'product' -%}
  {%- if product.featured_media -%}{%- assign og_image = product.featured_media.preview_image -%}{%- endif -%}
{%- elsif request.page_type == 'article' -%}
  {%- assign og_title = article.title -%}
  {%- assign og_type = 'article' -%}
  {%- if article.image -%}{%- assign og_image = article.image -%}{%- endif -%}
{%- elsif request.page_type == 'collection' -%}
  {%- assign og_title = collection.title -%}
  {%- if collection.image -%}
    {%- assign og_image = collection.image -%}
  {%- elsif collection.products.first.featured_media -%}
    {%- assign og_image = collection.products.first.featured_media.preview_image -%}
  {%- endif -%}
{%- endif -%}

{%- if og_image == blank and shop.brand.logo -%}
  {%- assign og_image = shop.brand.logo -%}
{%- endif -%}

{%- assign og_description = page_description | default: shop.description | default: shop.name -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | strip_html | escape }}">
<meta property="og:description" content="{{ og_description | strip_html | escape }}">
<meta property="og:url" content="{{ canonical_url }}">

{%- if og_image != blank -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  {%- if og_image.width -%}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- endif -%}
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign og_variant = product.selected_or_first_available_variant -%}
  <meta property="product:price:amount" content="{{ og_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if og_variant.available %}in stock{% else %}out of stock{% endif %}">
  {%- if product.vendor != blank -%}
    <meta property="product:brand" content="{{ product.vendor | escape }}">
  {%- endif -%}
{%- elsif request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:section" content="{{ blog.title | escape }}">
  {%- for tag in article.tags limit: 6 -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}
{%- endif -%}

<meta name="twitter:card" content="{% if og_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | strip_html | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | truncate: 200 | escape }}">
{%- if og_image != blank -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
